{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "local-dining-intelligence",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "observability": { "enabled": true }
}

